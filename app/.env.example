# Copy to .env.local and fill in
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# For local validator:
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899

# Security (production): leave sandbox/admin/iframe flags unset.
# NEXT_PUBLIC_ENABLE_DEVNET_SANDBOX=1
# NEXT_PUBLIC_ENABLE_DEVNET_ADMIN=1
# NEXT_PUBLIC_ALLOW_IFRAME=1
