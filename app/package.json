{
  "name": "ledgerline-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "generate:client": "npm run client:sync --prefix ..",
    "sync:idl": "npm run sync:idl --prefix .."
  },
  "dependencies": {
    "@ledgerline/ledgerline": "file:../clients/ts/ledgerline",
    "@solana/kit": "^8.3.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-wallet": "^0.20.0",
    "@solana/program-client-core": "^8.3.0",
    "@solana/react": "^8.3.0",
    "@tanstack/react-query": "^5.0.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^15.5.25",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
