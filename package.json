{
  "name": "ledgerline",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "npm run dev --prefix app",
    "dev:clean": "npm run dev:clean --prefix app",
    "dev:app": "npm run dev --prefix app",
    "test": "bash scripts/run-tests.sh",
    "test:all": "bash scripts/run-tests.sh 'tests/**/*.ts'",
    "fetch:token2022": "python3 scripts/fetch-token-2022.py",
    "lint:fix": "prettier */*.ts \"*/**/*{.js,.ts}\" -w",
    "generate:client": "node scripts/codama-generate.mjs",
    "sync:idl": "node scripts/sync-idl-from-anchor.mjs",
    "client:sync": "npm run sync:idl && npm run generate:client",
    "devnet:mints": "node app/scripts-devnet-mints.cjs",
    "devnet:bootstrap": "node scripts/devnet-bootstrap.cjs",
    "devnet:fresh": "powershell -ExecutionPolicy Bypass -File scripts/devnet-fresh-start.ps1",
    "devnet:continue": "powershell -ExecutionPolicy Bypass -File scripts/devnet-fresh-continue.ps1",
    "devnet:fund-wallet": "node scripts/send-demo-tokens.cjs",
    "devnet:draw": "node scripts/keeper-draw.cjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.3"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/renderers-js": "^2.5.0",
    "@codama/visitors-core": "^1.10.0",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.3.5"
  }
}
